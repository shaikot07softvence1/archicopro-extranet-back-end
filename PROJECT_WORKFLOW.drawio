        </mxCell>
        <mxCell id="loginFlow" value="Login Flow&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;POST /auth/login&lt;br&gt;GET /user/users/me&lt;br&gt;store token, refreshToken, user in localStorage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="1040" y="110" width="300" height="105" as="geometry" />
        </mxCell>
